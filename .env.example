# Optional: leave blank to run FRIDAY's local/basic mode.
# Never share a real key or commit this file after adding one.

# OpenAI-compatible API settings (works with OpenAI or xAI/Grok).
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Speech-recognition language. The default is Indian English.
SPEECH_LANGUAGE=en-IN

# Higher values make FRIDAY react to quieter speech. Use 1.7 by default.
MIC_SENSITIVITY=1.7

# Local AI model used by Ollama. Do not change unless you installed another model.
OLLAMA_MODEL=qwen3:4b

# Optional exact Windows voice name. Leave blank to use FRIDAY's default voice.
# Example: FRIDAY_VOICE=Microsoft Mark
FRIDAY_VOICE=
